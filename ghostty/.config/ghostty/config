# Lovely font
font-family = JetBrainsMono Nerd Font Mono
# Lovely theme
theme = Gruvbox Dark
# Good for my old eyes
font-size = 13
# Holy fuck does it look terrible without this
font-thicken = true
# This is what I'm used to at this point
cursor-style = block
# Without this, the above doesn't apply
shell-integration-features = no-cursor
# Seems distracting that it blinks
cursor-style-blink = false

# Do not display title in titlebar
title = " "
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = transparent

# New pane/window should not inherit workdir
window-inherit-working-directory = false
# This helps minimize the empty space below a pane/window
window-padding-balance = true

# Left option key should behave as alt.
macos-option-as-alt = left

# Start tmux immediately
initial-command="~/.config/ghostty/ghosttmux.sh"
# === KEY BINDINGS START === #
# Cmd shortcuts are bridged into tmux via tmux's `user-keys`, NOT via the prefix.
# Each binding emits one private CSI-u sequence:  ESC [ (57501+N) u
# .tmux.conf names that sequence `UserN` (user-keys[N]) and binds it in the root
# table, so it is one hop with no prefix state and no shell fork.
#
#   INVARIANT:  UserN  <=>  csi:(57501+N)u   -- keep both files in step.
#
# 57501+ sits in the Unicode private-use area above kitty's functional-key block
# (57344-57454), so nothing else claims these.
# Outside tmux these sequences are inert (same as the old \x00-prefixed ones).

# --- tmux-native: window navigation 1-7 (N=0..6) ---
keybind = super+digit_1=csi:57501u
keybind = super+digit_2=csi:57502u
keybind = super+digit_3=csi:57503u
keybind = super+digit_4=csi:57504u
keybind = super+digit_5=csi:57505u
keybind = super+digit_6=csi:57506u
keybind = super+digit_7=csi:57507u

# --- tmux-native: split, pane navigation, kill pane, lazygit (N=7..13, 23) ---
# super+t splits top/bottom, super+shift+t splits side by side.
# NOTE: this overrides ghostty's own Cmd+T (new tab); tmux windows replace tabs.
keybind = super+t=csi:57524u
keybind = super+shift+t=csi:57508u
keybind = super+h=csi:57509u
keybind = super+j=csi:57510u
keybind = super+k=csi:57511u
keybind = super+l=csi:57512u
keybind = super+w=csi:57513u
keybind = super+g=csi:57514u

# --- helix-only (N=14..22) ---
# tmux drops these unless the focused pane is running hx/nhx, so they are safe
# to press anywhere; nothing happens outside the editor.
keybind = super+s=csi:57515u
keybind = super+f=csi:57516u
keybind = super+b=csi:57517u
keybind = super+e=csi:57518u
keybind = super+c=csi:57519u
keybind = super+r=csi:57520u
keybind = ctrl+shift+f=csi:57521u
keybind = super+z=csi:57522u
keybind = super+shift+z=csi:57523u
# === KEY BINDINGS END === #
